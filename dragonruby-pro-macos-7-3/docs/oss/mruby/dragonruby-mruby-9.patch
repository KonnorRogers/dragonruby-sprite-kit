    it parameter (similar to numbered parameter _1) implemented in parser.

diff --git a/mruby/mrbgems/mruby-compiler/core/parse.y b/mruby/mrbgems/mruby-compiler/core/parse.y
index 8e68fa21a..dca5703a2 100644
--- a/mruby/mrbgems/mruby-compiler/core/parse.y
+++ b/mruby/mrbgems/mruby-compiler/core/parse.y
@@ -1466,6 +1466,7 @@ heredoc_end(parser_state *p)
 %token <nd>  tNTH_REF tBACK_REF
 %token <num> tREGEXP_END
 %token <num> tNUMPARAM "numbered parameter"
+%token <num> tIT "it parameter"
 
 %type <nd> singleton string string_fragment string_rep string_interp xstring regexp
 %type <nd> literal numeric cpath symbol defn_head defs_head
@@ -2103,6 +2104,10 @@ lhs             : variable
                     {
                       yyerror(p, "can't assign to numbered parameter");
                     }
+                | tIT
+                    {
+                      yyerror(p, "can't assign to it");
+                    }
                 ;
 
 cname           : tIDENTIFIER
@@ -2642,6 +2647,10 @@ primary         : literal
                     {
                       $$ = new_nvar(p, $1);
                     }
+                | tIT
+                    {
+                      $$ = new_nvar(p, 1);
+                    }
                 | tFID
                     {
                       $$ = new_fcall(p, $1, 0);
@@ -3500,6 +3509,10 @@ var_lhs         : variable
                     {
                       yyerror(p, "can't assign to numbered parameter");
                     }
+                | tIT
+                    {
+                      yyerror(p, "can't assign to it");
+                    }
                 ;
 
 var_ref         : variable
@@ -3809,6 +3822,11 @@ f_bad_arg       : tCONSTANT
                       yyerror(p, "formal argument cannot be a numbered parameter");
                       $$ = 0;
                     }
+                | tIT
+                    {
+                      yyerror(p, "formal argument cannot be it");
+                      $$ = 0;
+                    }
                 ;
 
 f_norm_arg      : f_bad_arg
@@ -6408,6 +6426,33 @@ parser_yylex(parser_state *p)
         }
       }
       /* fall through */
+    case 'i':
+      if (p->lstate != EXPR_FNAME && p->lstate != EXPR_DOT && toklen(p) == 2 && tok(p)[1] == 't' && p->nvars) {
+        int nvar;
+        node *nvars = p->nvars->cdr;
+
+        /* Check for outer block usage (same as tNUMPARAM) */
+        while (nvars) {
+          nvar = intn(nvars->car);
+          if (nvar == -2) break; /* top of the scope */
+          if (nvar > 0) {
+            yywarning(p, "'it' used in outer block");
+            break;
+          }
+          nvars->car = nint(-1);
+          nvars = nvars->cdr;
+        }
+        nvar = intn(p->nvars->car);
+        if (nvar == -1) {
+          yywarning(p, "'it' used in inner block");
+        }
+        if (nvar >= -1) {
+          pylval.num = 1;  /* 'it' is always parameter 1 */
+          p->lstate = EXPR_END;
+          return tIT;
+        }
+      }
+      /* fall through */
     default:
       if (toklast(p) == '!' || toklast(p) == '?') {
         result = tFID;
